NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://enertrack:change-this-password@localhost:5432/enertrack
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_SAME_SITE=lax
TRUST_PROXY=false
FRONTEND_ORIGINS=
MAX_JSON_BODY=16mb

# Configure SMTP to enable self-service password reset.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=EnerTrack <no-reply@example.com>
PUBLIC_APP_URL=http://localhost:3000
